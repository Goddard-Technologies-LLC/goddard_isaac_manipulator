format: xrdf
format_version: 1.0

modifiers:
  - set_base_frame: "base_link"

default_joint_positions:
  shoulder_pan_joint: 0.0
  shoulder_lift_joint: -2.2
  elbow_joint: 1.9
  wrist_1_joint: -1.383
  wrist_2_joint: -1.57
  wrist_3_joint: 0.0

cspace:
  joint_names:
    - "shoulder_pan_joint"
    - "shoulder_lift_joint"
    - "elbow_joint"
    - "wrist_1_joint"
    - "wrist_2_joint"
    - "wrist_3_joint"
  acceleration_limits: [12.0, 12.0, 12.0, 12.0, 12.0, 12.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["tool0"]

collision:
  geometry: "ur3e_collision_spheres"
  buffer_distance:
    shoulder_link: 0.01
    upper_arm_link: 0.01
    forearm_link: 0.01
    wrist_1_link: 0.01
    wrist_2_link: 0.01
    wrist_3_link: 0.01
    tool0: 0.025

self_collision:
  geometry: "ur3e_collision_spheres"
  buffer_distance:
    tool0: 0.025
  ignore:
    upper_arm_link: ["forearm_link", "shoulder_link"]
    forearm_link: ["wrist_1_link"]
    wrist_1_link: ["wrist_2_link","wrist_3_link"]
    wrist_2_link: ["wrist_3_link", "tool0"]
    wrist_3_link: ["tool0"]

geometry:
  ur3e_collision_spheres:
    spheres:
      shoulder_link:
        - center: [0, 0, 0]
          radius: 0.04
      upper_arm_link:
        - center: [0, 0, 0.12]
          radius: 0.06
        - center: [-0.081, 0, 0.12]
          radius: 0.04
        - center: [-0.162, 0, 0.12]
          radius: 0.04
        - center: [-0.243, 0, 0.12]
          radius: 0.04
      forearm_link:
        - center: [0, 0, 0.02]
          radius: 0.04
        - center: [-0.075, 0, 0.02]
          radius: 0.04
        - center: [-0.15, 0, 0.02]
          radius: 0.04
        - center: [-0.225, 0, 0.02]
          radius: 0.04
      wrist_1_link:
        - center: [0, 0, 0]
          radius: 0.04
      wrist_2_link:
        - center: [0, 0, 0]
          radius: 0.04
      wrist_3_link:
        - center: [0, 0, 0]
          radius: 0.04
        - center: [0, 0, 0.04]
          radius: 0.05
      tool0:
        - center: [0, 0, 0.09]
          radius: 0.04
